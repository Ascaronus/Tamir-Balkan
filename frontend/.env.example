# Copy to frontend/.env.local; these NEXT_PUBLIC values are visible to browsers.
# Never put database, SMTP, JWT, admin or private API secrets here.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Storefront origin; on production it must be https://tamir.rs. It is inlined at build time
# and checked against the Origin header of chat POSTs (docs/TAMIR-CHAT.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side only (read by the /privacy page on the server; never shipped to the browser).
# Contact address for the privacy policy page; leave empty to show the "contact pending" placeholder.
TAMIR_PRIVACY_EMAIL=

# Copy to backend/.env; fill locally. See docs/SECRETS.md.
# DATABASE_URL must include the matching database password, URL-encoded if needed.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
MEDUSA_PUBLIC_BACKEND_URL=http://localhost:9000
# Auth cookie "Secure" flag. Defaults to on in production (HTTPS) and off elsewhere,
# so a production copy needs nothing here. Uncomment ONLY for a plain-HTTP local host.
# COOKIE_SECURE=false

# Production: set the real domains above and configure email and CAPTCHA below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
# Optional separate HMAC secret; otherwise JWT_SECRET is used.
REVIEW_RATE_SECRET=
# Optional server-side translation provider key.
GOOGLE_TRANSLATE_API_KEY=
